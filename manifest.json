{
  "manifest_version": 3,
  "name": "Ollie",
  "version": "0.1.0",
  "description": "A pixel-grid octopus companion for focus sessions.",
  "permissions": [
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Ollie",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/companion-view.js",
        "content/drag-controller.js",
        "content/ink-splatter-view.js",
        "content/intervention-controller.js",
        "content/ollie-choreography.js",
        "content/ollie-behavior-controller.js",
        "content/ollie-grid.js",
        "content/speech-bubble.js",
        "content/speech-bubble-controller.js",
        "content/overlay.css",
        "content/animations.css",
        "assets/ink/canonical/*.svg"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
